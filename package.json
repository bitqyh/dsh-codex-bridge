{
  "name": "@bitqyh/dsh-codex-bridge",
  "version": "0.1.1",
  "description": "在 DSH 输入框下方列出可接续的 Codex 聊天，按具体项目分组，只把恢复内容插入草稿、不自动发送。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./ui": "./src/ui-server.js",
    "./ui-client": "./src/ui-client.js",
    "./package.json": "./package.json",
    "./client": "./src/ui-client.js"
  },
  "files": [
    "cordis.patch.yml",
    "src/index.js",
    "src/ui-server.js",
    "src/ui-client.js",
    "bin/cli.mjs",
    "assets/hooks/*",
    "assets/tools/*.py",
    "assets/tools/*.sh",
    "assets/skills/**/*",
    "COMPARISON.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node test-plugin.mjs && node tests/ui-tests.mjs && python3 tests/batch1-tests.py && python3 tests/batch2-tests.py && python3 tests/batch3-tests.py && python3 tests/batch4-resume-tests.py && python3 tests/project-scope-tests.py",
    "test:ui": "node tests/ui-tests.mjs"
  },
  "bin": {
    "dsh-codex-bridge": "bin/cli.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitqyh/dsh-codex-bridge.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "codex",
    "handoff",
    "resume",
    "session",
    "cordis"
  ],
  "homepage": "https://github.com/bitqyh/dsh-codex-bridge#readme",
  "bugs": {
    "url": "https://github.com/bitqyh/dsh-codex-bridge/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
